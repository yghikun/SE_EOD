{
  "schema_version": 1,
  "protocol_id": "fmpca.relocation_root_attachment_settlement",
  "protocol_version": "0.3.0-draft",
  "semantic_intent": "A runtime relocation merge that observes a preexisting fs_root-to-reloc_root attachment must settle that relation to its entry prestate before the relocation owner returns or teardown takes ownership.",
  "roles": [
    {"id": "operation", "kind": "operation", "anchor": true, "required": true},
    {"id": "fs_root", "kind": "container", "anchor": true, "required": true},
    {"id": "relocation_root", "kind": "member", "anchor": false, "required": true},
    {"id": "relocation_owner", "kind": "owner", "anchor": false, "required": true},
    {"id": "attachment_origin", "kind": "authority", "anchor": false, "required": false}
  ],
  "epoch_policy": {"include": ["operation_root", "retry_generation"]},
  "entry_formula": {"op": "all", "items": [
    {"op": "role_bound", "role": "operation"},
    {"op": "role_bound", "role": "fs_root"},
    {"op": "role_bound", "role": "relocation_owner"}
  ]},
  "initial_phase": "ATTACHED",
  "phases": ["ATTACHED", "FAILURE_PENDING", "RESTORED", "SETTLED"],
  "events": ["RelocationAttachmentPrestate", "RelocationAttachmentObserved", "RelocationFailure", "RelocationDetach", "OperationReturn", "OwnerTermination", "ProtocolComplete"],
  "transitions": [
    {"event": "RelocationAttachmentPrestate", "from": ["ATTACHED"], "to": "ATTACHED", "guard": {"op": "literal", "value": true}, "actions": [
      {"op": "snapshot_relation_from_event"},
      {"op": "set_relation", "name": "fs_root.reloc_root", "value": "DETACHED"}
    ]},
    {"event": "RelocationAttachmentObserved", "from": ["ATTACHED"], "to": "ATTACHED", "guard": {"op": "literal", "value": true}, "actions": [
      {"op": "set_relation_from_event"}
    ]},
    {"event": "RelocationFailure", "from": ["ATTACHED", "FAILURE_PENDING"], "to": "FAILURE_PENDING", "guard": {"op": "literal", "value": true}, "actions": [
      {"op": "activate_obligation", "template": "RRM-O1", "relation": "$event.relation"}
    ]},
    {"event": "RelocationDetach", "from": ["FAILURE_PENDING"], "to": "RESTORED", "guard": {"op": "literal", "value": true}, "actions": [
      {"op": "restore_relation_from_event", "template": "RRM-O1"}
    ]},
    {"event": "OperationReturn", "from": ["FAILURE_PENDING", "RESTORED"], "to": "SETTLED", "guard": {"op": "literal", "value": true}, "actions": []},
    {"event": "OwnerTermination", "from": ["ATTACHED", "FAILURE_PENDING", "RESTORED", "SETTLED"], "to": "SETTLED", "guard": {"op": "literal", "value": true}, "actions": []},
    {"event": "ProtocolComplete", "from": ["RESTORED"], "to": "SETTLED", "guard": {"op": "literal", "value": true}, "actions": []}
  ],
  "invariants": [
    {"id": "RRM-I1", "deadline": "AT_SETTLEMENT", "formula": {"op": "relation_equals", "name": "root.reloc_root", "value": "DETACHED"}, "evidence": ["trace:RRM-I1"]}
  ],
  "obligation_templates": [
    {"id": "RRM-O1", "required_formula": {"op": "relation_matches_prestate", "name": "$obligation.relation"}, "activation_horizon": "RelocationFailure", "deadline_policy": "MAY_DELEGATE_TO", "delegation_deadline": "AT_SETTLEMENT", "completion_deadline": "AT_SETTLEMENT", "allowed_authorities": ["relocation_teardown"]}
  ],
  "allowed_authorities": ["relocation_teardown"],
  "deadlines": ["ALWAYS", "AT_SETTLEMENT", "BEFORE_OWNER_TERMINATION"],
  "checkpoint_events": ["RelocationFailure"],
  "terminal_events": ["OperationReturn", "OwnerTermination", "ProtocolComplete"],
  "acceptance_formula": {"op": "all", "items": [
    {"op": "phase_in", "values": ["SETTLED", "RESTORED"]},
    {"op": "no_irreversible_violation"}
  ]},
  "frame_relations": ["unrelated_reloc_roots", "generic_resource_count"],
  "semantic_footprint": ["fs_root_reloc_root_attachment", "root_reference_ownership", "preexisting_attachment_origin", "relocation_failure", "owner_termination"],
  "evidence_references": ["candidate:runtime-relocation-merge", "dossier:heldout-ras-runtime-relocation-merge", "trace:RRM-I1", "trace:RRM-O1"]
}
