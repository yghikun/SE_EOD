{
  "schema_version": 1,
  "protocol_id": "fixture.membership_consistency",
  "protocol_version": "0.1.0",
  "semantic_intent": "Synthetic fixture proving that DSL roles, relation restoration, obligations, and settlement are executable; not research evidence.",
  "roles": [
    {"id": "operation", "kind": "operation", "anchor": true, "required": true},
    {"id": "container", "kind": "container", "anchor": true, "required": true},
    {"id": "member", "kind": "member", "anchor": false, "required": true}
  ],
  "epoch_policy": {"include": ["operation_root", "retry_generation"]},
  "entry_formula": {"op": "all", "items": [
    {"op": "role_bound", "role": "operation"},
    {"op": "role_bound", "role": "container"}
  ]},
  "initial_phase": "STABLE",
  "phases": ["STABLE", "MUTATING", "ROLLBACK_PENDING", "SETTLED"],
  "events": ["SnapshotPrestate", "RelationUpdate", "FailureObserved", "RestoreRelation", "OperationReturn"],
  "transitions": [
    {"event": "SnapshotPrestate", "from": ["STABLE", "MUTATING"], "to": "MUTATING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "snapshot_relation_from_event"}]},
    {"event": "RelationUpdate", "from": ["MUTATING"], "to": "MUTATING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "update_relation_from_event"}]},
    {"event": "FailureObserved", "from": ["MUTATING"], "to": "ROLLBACK_PENDING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "activate_obligations_for_deltas", "template": "MEM-O1"}]},
    {"event": "RestoreRelation", "from": ["ROLLBACK_PENDING"], "to": "ROLLBACK_PENDING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "restore_relation_from_event", "template": "MEM-O1"}]},
    {"event": "OperationReturn", "from": ["MUTATING", "ROLLBACK_PENDING"], "to": "SETTLED", "guard": {"op": "literal", "value": true}, "actions": []}
  ],
  "invariants": [],
  "obligation_templates": [
    {"id": "MEM-O1", "required_formula": {"op": "relation_matches_prestate", "name": "$obligation.relation"}, "activation_horizon": "FailureObserved", "deadline_policy": "MUST_DISCHARGE", "delegation_deadline": null, "completion_deadline": "AT_SETTLEMENT", "allowed_authorities": []}
  ],
  "allowed_authorities": [],
  "deadlines": ["ALWAYS", "BEFORE_EXPOSURE", "BEFORE_COMMIT", "AT_SETTLEMENT", "BEFORE_OWNER_TERMINATION"],
  "checkpoint_events": [],
  "terminal_events": ["OperationReturn"],
  "acceptance_formula": {"op": "phase_in", "values": ["SETTLED"]},
  "frame_relations": ["unrelated_fields"],
  "semantic_footprint": ["membership", "member_count"],
  "evidence_references": ["synthetic-fixture-only"]
}

