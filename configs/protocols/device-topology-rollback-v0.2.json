{
  "schema_version": 1,
  "protocol_id": "fmpca.device_topology_rollback",
  "protocol_version": "0.2.0",
  "semantic_intent": "A seed-to-sprout device topology transition must restore membership, active-device identity and topology metadata together when the transaction fails before settlement.",
  "roles": [
    {"id": "operation", "kind": "operation", "anchor": true, "required": true},
    {"id": "topology", "kind": "container", "anchor": true, "required": true},
    {"id": "seed_container", "kind": "container", "anchor": false, "required": false},
    {"id": "sprout_container", "kind": "container", "anchor": false, "required": false},
    {"id": "device", "kind": "member", "anchor": false, "required": false},
    {"id": "active_device", "kind": "pointer", "anchor": false, "required": false},
    {"id": "transaction_owner", "kind": "owner", "anchor": false, "required": false},
    {"id": "rollback_authority", "kind": "authority", "anchor": false, "required": false}
  ],
  "epoch_policy": {"include": ["operation_root", "retry_generation"]},
  "entry_formula": {"op": "all", "items": [
    {"op": "role_bound", "role": "operation"},
    {"op": "role_bound", "role": "topology"}
  ]},
  "initial_phase": "STABLE",
  "phases": ["STABLE", "MUTATING", "FAILURE_OBSERVED", "ROLLBACK_PENDING", "DELEGATED", "RESTORED", "SETTLED"],
  "events": ["InitializeTopology", "SnapshotTopology", "TopologyMutation", "ActiveDeviceRebind", "FailureObserved", "RestoreTopology", "DelegateTopologyRollback", "AuthorityComplete", "LiveExposure", "ReleaseDevice", "OperationReturn", "OwnerTermination", "ProtocolComplete"],
  "transitions": [
    {"event": "InitializeTopology", "from": ["STABLE"], "to": "STABLE", "guard": {"op": "literal", "value": true}, "actions": [{"op": "set_relation_from_event"}]},
    {"event": "SnapshotTopology", "from": ["STABLE", "MUTATING"], "to": "MUTATING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "snapshot_relation_from_event"}]},
    {"event": "TopologyMutation", "from": ["STABLE", "MUTATING"], "to": "MUTATING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "update_relation_from_event"}]},
    {"event": "ActiveDeviceRebind", "from": ["MUTATING"], "to": "MUTATING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "update_relation_from_event"}]},
    {"event": "FailureObserved", "from": ["MUTATING", "FAILURE_OBSERVED"], "to": "ROLLBACK_PENDING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "activate_obligations_for_deltas", "template": "DTR-O1"}]},
    {"event": "RestoreTopology", "from": ["ROLLBACK_PENDING", "DELEGATED", "RESTORED"], "to": "RESTORED", "guard": {"op": "literal", "value": true}, "actions": [{"op": "restore_relation_from_event", "template": "DTR-O1"}]},
    {"event": "DelegateTopologyRollback", "from": ["ROLLBACK_PENDING", "DELEGATED"], "to": "DELEGATED", "guard": {"op": "literal", "value": true}, "actions": [{"op": "delegate_relation_from_event", "template": "DTR-O1"}]},
    {"event": "AuthorityComplete", "from": ["DELEGATED", "ROLLBACK_PENDING", "RESTORED"], "to": "RESTORED", "guard": {"op": "literal", "value": true}, "actions": [{"op": "restore_relation_from_event", "template": "DTR-O1"}, {"op": "complete_authority", "authority": {"from_event": "authority"}, "relation": "$event.relation"}]},
    {"event": "LiveExposure", "from": ["MUTATING", "ROLLBACK_PENDING", "RESTORED"], "to": "ROLLBACK_PENDING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "set_relation_from_event"}, {"op": "record_irreversible_if_false", "relation": "active_target_valid", "code": "INVALID_DEVICE_TARGET_EXPOSED"}]},
    {"event": "ReleaseDevice", "from": ["MUTATING", "ROLLBACK_PENDING", "RESTORED"], "to": "ROLLBACK_PENDING", "guard": {"op": "literal", "value": true}, "actions": [{"op": "set_relation_from_event"}]},
    {"event": "OperationReturn", "from": ["MUTATING", "ROLLBACK_PENDING", "DELEGATED", "RESTORED"], "to": "SETTLED", "guard": {"op": "literal", "value": true}, "actions": []},
    {"event": "OwnerTermination", "from": ["MUTATING", "ROLLBACK_PENDING", "DELEGATED", "RESTORED", "SETTLED"], "to": "SETTLED", "guard": {"op": "literal", "value": true}, "actions": []},
    {"event": "ProtocolComplete", "from": ["RESTORED"], "to": "SETTLED", "guard": {"op": "literal", "value": true}, "actions": []}
  ],
  "invariants": [
    {"id": "DTR-I1", "deadline": "ALWAYS", "formula": {"op": "any", "items": [{"op": "not", "item": {"op": "role_bound", "role": "active_device"}}, {"op": "relation_equals", "name": "active_target_valid", "value": true}]}, "evidence": ["trace:DTR-I1"]},
    {"id": "DTR-I2", "deadline": "BEFORE_EXPOSURE", "formula": {"op": "any", "items": [{"op": "not", "item": {"op": "role_bound", "role": "active_device"}}, {"op": "relation_equals", "name": "active_target_valid", "value": true}]}, "evidence": ["trace:DTR-I2"]},
    {"id": "DTR-I3", "deadline": "BEFORE_RELEASE", "formula": {"op": "relation_equals", "name": "released_device_detached", "value": true}, "evidence": ["trace:DTR-I3"]}
  ],
  "obligation_templates": [
    {"id": "DTR-O1", "required_formula": {"op": "relation_matches_prestate", "name": "$obligation.relation"}, "activation_horizon": "FailureObserved", "deadline_policy": "MAY_DELEGATE_TO", "delegation_deadline": "AT_SETTLEMENT", "completion_deadline": "AT_SETTLEMENT", "allowed_authorities": ["transaction_owner", "topology_owner"]}
  ],
  "allowed_authorities": ["transaction_owner", "topology_owner"],
  "deadlines": ["ALWAYS", "BEFORE_EXPOSURE", "BEFORE_RELEASE", "BEFORE_COMMIT", "AT_SETTLEMENT", "BEFORE_OWNER_TERMINATION"],
  "checkpoint_events": ["FailureObserved", "DelegateTopologyRollback", "LiveExposure", "ReleaseDevice"],
  "terminal_events": ["OperationReturn", "OwnerTermination", "ProtocolComplete"],
  "acceptance_formula": {"op": "all", "items": [{"op": "phase_in", "values": ["SETTLED", "RESTORED"]}, {"op": "no_irreversible_violation"}]},
  "frame_relations": ["generic_resource_count", "unrelated_transaction_state"],
  "semantic_footprint": ["device_membership", "post_commit_update_ownership", "active_device_identity", "sprout_container", "fsid_identity", "transaction_failure", "topology_settlement"],
  "evidence_references": ["catalog-v0.2:DeviceTopologyRollback", "dossiers:#16/#17/#18", "trace:DTR-I1", "trace:DTR-I2", "trace:DTR-O1"]
}
