{
  "schema_version": 1,
  "taxonomy_id": "fmpca.protocol_scope_taxonomy",
  "taxonomy_version": "0.1.0",
  "semantic_scopes": {
    "COMMON": {
      "description": "The canonical object, relation, lifecycle, authority and deadline semantics close in at least two independent filesystems.",
      "permits_cross_filesystem_claim": true
    },
    "FS_FAMILY": {
      "description": "The semantics close only within a named implementation family and are not claimed for unrelated filesystems.",
      "permits_cross_filesystem_claim": false
    },
    "FS_SPECIFIC": {
      "description": "The semantics close in one filesystem and retain that filesystem's native objects and lifecycle.",
      "permits_cross_filesystem_claim": false
    }
  },
  "freeze_boundaries": {
    "STANDARD": {
      "description": "The declared semantic scope is frozen without an additional narrowness qualifier."
    },
    "NARROW_FREEZE": {
      "description": "Only the evidenced semantic footprint and replay closure are frozen; no broader applicability is implied."
    }
  },
  "correspondence_dimensions": [
    "object",
    "relation",
    "lifecycle",
    "authority",
    "deadline"
  ],
  "validation_roles": [
    "DEVELOPMENT",
    "VALIDATION",
    "HELD_OUT"
  ],
  "applicability": {
    "statuses": [
      "APPLICABLE",
      "NON_APPLICABLE",
      "UNRESOLVED"
    ],
    "non_applicable_reason_codes": [
      "OBJECT_ABSENT",
      "RELATION_NOT_ISOMORPHIC",
      "LIFECYCLE_INCOMPATIBLE",
      "AUTHORITY_NOT_ALIGNED",
      "DEADLINE_NOT_ALIGNED"
    ],
    "rules": [
      "UNRESOLVED never counts as evidence for a broader scope.",
      "NON_APPLICABLE requires a controlled reason code and an evidence note.",
      "No discovered counterpart is UNRESOLVED unless absence has been established from source or design evidence."
    ]
  },
  "common_readiness": {
    "candidate_required_gates": [
      "canonical_dsl_defined",
      "bindings_defined",
      "source_witness_defined",
      "development_fs_replay_closed",
      "result_partition_closed"
    ],
    "freeze_required_gates": [
      "common_candidate_ready",
      "minimum_two_applicable_filesystems",
      "all_correspondence_dimensions_closed",
      "independent_operation_family_per_filesystem",
      "source_witness_closed_per_filesystem",
      "replay_closed_per_filesystem",
      "proof_closure_closed_per_filesystem",
      "protocol_binding_test_hashes_locked"
    ],
    "heldout_required_gates": [
      "common_freeze_ready",
      "third_filesystem_post_freeze",
      "heldout_correspondence_closed",
      "heldout_source_witness_closed",
      "heldout_replay_closed",
      "heldout_proof_closure_closed",
      "no_post_freeze_semantic_modifications"
    ]
  },
  "scope_declaration_required_gates": {
    "FS_SPECIFIC": [
      "at_least_one_applicable_filesystem"
    ],
    "FS_FAMILY": [
      "named_filesystem_family",
      "minimum_two_family_members",
      "all_members_match_named_family"
    ],
    "COMMON": [
      "common_freeze_ready"
    ]
  },
  "current_protocol_scopes": [
    {
      "protocol_id": "fmpca.chunk_metadata_reservation_completion",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "NARROW_FREEZE",
      "filesystem_or_family": "Btrfs",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "The v0.5 freeze and E6 held-out family close inside Btrfs only."
    },
    {
      "protocol_id": "fmpca.writable_device_capacity_contribution",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "STANDARD",
      "filesystem_or_family": "Btrfs",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "The frozen capacity objects and settlement witnesses are Btrfs-specific."
    },
    {
      "protocol_id": "fmpca.device_topology_capacity_composition",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "STANDARD",
      "filesystem_or_family": "Btrfs",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "The DTR/WDC composition inherits Btrfs identity, capacity and release semantics."
    },
    {
      "protocol_id": "fmpca.device_topology_rollback",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "STANDARD",
      "filesystem_or_family": "Btrfs",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "Name similarity is not cross-filesystem object or authority correspondence."
    },
    {
      "protocol_id": "fmpca.device_shrink_space_accounting",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "NARROW_FREEZE",
      "filesystem_or_family": "Btrfs",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "Only the evidenced Btrfs shrink accounting footprint is frozen."
    },
    {
      "protocol_id": "fmpca.relocation_root_attachment_settlement",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "NARROW_FREEZE",
      "filesystem_or_family": "Btrfs",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "The relocation-root lifecycle is frozen narrowly and has no cross-filesystem claim."
    },
    {
      "protocol_id": "fmpca.recovery_attachment_settlement",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "STANDARD",
      "filesystem_or_family": "Btrfs",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "Cross-filesystem object, authority and deadline correspondence must be re-established before promotion."
    },
    {
      "protocol_id": "fmpca.orphan_inode_deletion_settlement",
      "semantic_scope": "FS_SPECIFIC",
      "freeze_boundary": "NARROW_FREEZE",
      "filesystem_or_family": "Btrfs/ext4 candidate evidence",
      "cross_filesystem_status": "UNRESOLVED",
      "rationale": "Btrfs and ext4 selected source paths and replay close, but per-filesystem all-path proof closure is still open, so COMMON promotion is not allowed."
    }
  ]
}
